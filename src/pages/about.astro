---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/ui/Navbar";
import PageHeader from "../components/PageHeader.astro";
import { 
  Sparkles, 
  Palette, 
  Code2, 
  Compass, 
  ArrowRight, 
  CheckCircle2, 
  Globe, 
  Lightbulb,
  Calendar
} from "lucide-react";
import { Button } from "../components/ui/moving-border";

const stats = [
  { value: "7+", label: "Years Experience", detail: "Crafting digital experiences" },
  { value: "45+", label: "Projects Delivered", detail: "For clients worldwide" },
  { value: "99%", label: "Client Satisfaction", detail: "Based on post-launch reviews" },
  { value: "12+", label: "Design Accolades", detail: "Recognitions & features" },
];

const pillars = [
  {
    number: "01",
    title: "Clarity over Noise",
    description: "We strip away decorative friction to reveal the core essence. Clear thinking produces clear design, allowing users to focus on what truly matters.",
    icon: Lightbulb,
  },
  {
    number: "02",
    title: "Quiet Elegance",
    description: "True luxury and impact don't shout. They reveal themselves through immaculate typography, generous whitespace, and balanced proportions.",
    icon: Palette,
  },
  {
    number: "03",
    title: "Technical Mastery",
    description: "Design is only as good as its execution. We build with modern web standards, ensuring featherlight performance and accessible code.",
    icon: Code2,
  },
  {
    number: "04",
    title: "Organic Motion",
    description: "Interfaces should feel alive. We craft micro-interactions and smooth transitions that respond naturally to user intent.",
    icon: Sparkles,
  },
];

const capabilities = [
  {
    category: "Design & Direction",
    description: "Translating brand identity into immersive, functional digital interfaces.",
    skills: ["UI/UX Product Design", "Design Systems & Tokens", "Art & Creative Direction", "Interactive Prototyping", "Typography & Editorial Layout"],
    icon: Palette,
  },
  {
    category: "Creative Engineering",
    description: "Bringing high-fidelity aesthetics to life with modern, performant web technologies.",
    skills: ["Astro / Next.js / React", "TypeScript & Strict Typing", "Tailwind CSS & Vanilla CSS", "Framer Motion & Micro-interactions", "Performance & SEO Optimization"],
    icon: Code2,
  },
  {
    category: "Strategy & Advisory",
    description: "Guiding product roadmaps and digital presence with analytical clarity.",
    skills: ["Product Discovery & Scoping", "Information Architecture", "Design System Audits", "Accessibility & WCAG", "Conversion Optimization"],
    icon: Compass,
  },
];

const milestones = [
  {
    year: "2025 – Present",
    role: "Founding Lumina Studio",
    company: "Independent Practice",
    description: "Partnering with visionary founders, design-led agencies, and modern brands to ship next-generation digital products and brand experiences.",
  },
  {
    year: "2023 – 2025",
    role: "Lead Product Designer & Technologist",
    company: "Venture Studio",
    description: "Led the design systems and frontend architecture for multiple high-growth SaaS applications and interactive web platforms.",
  },
  {
    year: "2021 – 2023",
    role: "Senior Interactive Designer",
    company: "Creative Digital Agency",
    description: "Designed bespoke digital experiences, brand portals, and immersive 3D-assisted web applications for international clients.",
  },
  {
    year: "2018 – 2021",
    role: "UI/UX & Frontend Specialist",
    company: "Digital Studio",
    description: "Honed craft across responsive typography, fluid layout systems, component libraries, and frontend performance.",
  },
];

const processSteps = [
  {
    step: "01",
    title: "Discover & Align",
    desc: "Understanding the core purpose, target audience, and business objectives to define the project foundation.",
  },
  {
    step: "02",
    title: "Explore & Prototype",
    desc: "Iterative wireframing, moodboarding, and interactive design prototypes to discover the ideal visual voice.",
  },
  {
    step: "03",
    title: "Build & Refine",
    desc: "Precision frontend development with clean code, responsive layouts, and buttery-smooth animations.",
  },
  {
    step: "04",
    title: "Deploy & Scale",
    desc: "Thorough testing, performance optimization, and launch support with ongoing design system documentation.",
  },
];
---

<Layout title="About | Lumina Studio">
  <Navbar client:load />

  <main class="overflow-hidden">
    {/* Hero Page Header */}
    <PageHeader 
      title="About" 
      highlight="Our Story" 
      description="We craft calm, intentional, and high-impact digital experiences at the intersection of timeless aesthetics and modern technology." 
    />

    {/* Manifesto & Studio Philosophy */}
    <section class="py-24 md:py-32 bg-canvas relative">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20 items-start">
          <div class="lg:col-span-4">
            <span class="inline-block text-xs uppercase tracking-[0.2em] text-ink-muted font-medium mb-4">
              Our Manifesto
            </span>
            <h2 class="text-3xl md:text-4xl font-serif text-ink tracking-tight leading-tight">
              Design is not how it looks. It is how it <span class="text-ink/50">resonates</span>.
            </h2>
          </div>

          <div class="lg:col-span-8 flex flex-col gap-6 text-lg md:text-xl text-ink-muted leading-relaxed">
            <p>
              In a digital landscape overcrowded with ephemeral noise and visual clutter, Lumina Studio was founded on a simple premise: great work speaks quietly with confidence.
            </p>
            <p>
              We bring together deep strategic thinking and obsessive attention to detail. Every pixel, transition, and line of code is chosen with deliberate intention to build products that feel effortless, intuitive, and unforgettable.
            </p>
            
            <div class="pt-4 flex flex-wrap items-center gap-6 border-t border-line mt-4">
              <div class="flex items-center gap-3">
                <div class="w-3 h-3 rounded-full bg-emerald-500 animate-pulse"></div>
                <span class="text-sm font-medium text-ink">Available for select projects</span>
              </div>
              <span class="text-line">•</span>
              <div class="flex items-center gap-2 text-sm text-ink-muted">
                <Globe size={16} />
                <span>Working globally (Remote)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Key Stats Section */}
    <section class="py-16 bg-[#F9F9F7] border-y border-line">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8 md:gap-12">
          {stats.map((stat) => (
            <div class="flex flex-col">
              <span class="text-4xl md:text-5xl font-serif text-ink tracking-tight mb-2">
                {stat.value}
              </span>
              <span class="text-sm md:text-base font-semibold text-ink mb-1">
                {stat.label}
              </span>
              <span class="text-xs md:text-sm text-ink-muted">
                {stat.detail}
              </span>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Core Pillars / Values (Bento Grid) */}
    <section class="py-24 md:py-32 bg-canvas relative">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="max-w-2xl mb-16">
          <span class="text-xs uppercase tracking-[0.2em] text-ink-muted font-medium block mb-3">
            Core Philosophy
          </span>
          <h2 class="text-3xl md:text-5xl font-serif text-ink tracking-tight">
            Principles that guide every <span class="text-ink/40">creation</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {pillars.map((pillar) => {
            const Icon = pillar.icon;
            return (
              <div class="p-8 md:p-10 rounded-3xl bg-canvas border border-line hover:border-line-strong hover:shadow-soft transition-all duration-300 relative group">
                <div class="flex items-center justify-between mb-8">
                  <span class="font-serif text-2xl text-ink/30 font-light">
                    {pillar.number}
                  </span>
                  <div class="p-3 rounded-2xl bg-[#F4F4F0] text-ink group-hover:scale-110 transition-transform duration-300">
                    <Icon size={22} />
                  </div>
                </div>
                <h3 class="text-xl md:text-2xl font-serif text-ink mb-3 tracking-tight">
                  {pillar.title}
                </h3>
                <p class="text-base text-ink-muted leading-relaxed font-sans">
                  {pillar.description}
                </p>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* Capabilities / Services Matrix */}
    <section class="py-24 md:py-32 bg-[#F9F9F7] relative overflow-hidden">
      {/* Soft atmospheric ambient glow */}
      <div class="absolute -bottom-24 -left-24 w-96 h-96 bg-sky-200/20 rounded-full blur-[100px] pointer-events-none" aria-hidden="true"></div>

      <div class="container mx-auto px-6 max-w-6xl relative z-10">
        <div class="max-w-2xl mb-16">
          <span class="text-xs uppercase tracking-[0.2em] text-ink-muted font-medium block mb-3">
            Capabilities & Stack
          </span>
          <h2 class="text-3xl md:text-5xl font-serif text-ink tracking-tight">
            Full-spectrum digital <span class="text-ink/40">craftsmanship</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {capabilities.map((cap) => {
            const Icon = cap.icon;
            return (
              <div class="p-8 rounded-3xl bg-canvas/90 backdrop-blur-md border border-line shadow-sm flex flex-col justify-between">
                <div>
                  <div class="w-12 h-12 rounded-2xl bg-canvas flex items-center justify-center text-ink mb-6 border border-line">
                    <Icon size={24} />
                  </div>
                  <h3 class="text-2xl font-serif text-ink mb-3 tracking-tight">
                    {cap.category}
                  </h3>
                  <p class="text-sm text-ink-muted leading-relaxed mb-6 font-sans">
                    {cap.description}
                  </p>
                </div>

                <div class="pt-6 border-t border-line/60">
                  <span class="text-xs uppercase tracking-wider text-ink-muted font-medium block mb-4">
                    Specializations
                  </span>
                  <ul class="space-y-2.5">
                    {cap.skills.map((skill) => (
                      <li class="flex items-center gap-2.5 text-sm text-ink font-medium">
                        <CheckCircle2 size={16} class="text-leaf shrink-0" />
                        <span>{skill}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    {/* Experience & Milestones Timeline */}
    <section class="py-24 md:py-32 bg-canvas relative">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-20">
          <div class="lg:col-span-4">
            <div class="sticky top-28">
              <span class="text-xs uppercase tracking-[0.2em] text-ink-muted font-medium block mb-3">
                Experience & Journey
              </span>
              <h2 class="text-3xl md:text-5xl font-serif text-ink tracking-tight mb-6 leading-tight">
                A timeline of continuous <span class="text-ink/40">refinement</span>
              </h2>
              <p class="text-base text-ink-muted leading-relaxed font-sans mb-8">
                Over the past 7+ years, we have evolved from indie frontend experiments to directing and engineering digital flagship experiences.
              </p>
              <a 
                href="#contact" 
                class="inline-flex items-center gap-2 text-sm font-bold text-ink hover:opacity-70 transition-opacity"
              >
                <span>Inquire about collaboration</span>
                <ArrowRight size={16} />
              </a>
            </div>
          </div>

          <div class="lg:col-span-8">
            <div class="space-y-12 relative before:absolute before:inset-0 before:left-3.5 before:w-px before:bg-line">
              {milestones.map((item) => (
                <div class="relative pl-10 group">
                  <div class="absolute left-2 top-1.5 w-3 h-3 rounded-full bg-ink border-4 border-canvas group-hover:scale-125 transition-transform duration-300"></div>
                  <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                    <h3 class="text-xl md:text-2xl font-serif text-ink tracking-tight">
                      {item.role}
                    </h3>
                    <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted bg-[#F4F4F0] px-3 py-1 rounded-full w-fit">
                      {item.year}
                    </span>
                  </div>
                  <span class="text-sm font-medium text-ink-muted block mb-3">
                    {item.company}
                  </span>
                  <p class="text-base text-ink-muted leading-relaxed font-sans">
                    {item.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* The Working Process */}
    <section class="py-24 md:py-32 bg-[#F9F9F7] border-t border-line">
      <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center max-w-2xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-[0.2em] text-ink-muted font-medium block mb-3">
            Our Approach
          </span>
          <h2 class="text-3xl md:text-5xl font-serif text-ink tracking-tight">
            How we bring ideas into <span class="text-ink/40">reality</span>
          </h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {processSteps.map((step) => (
            <div class="p-8 rounded-3xl bg-canvas border border-line hover:border-line-strong transition-all duration-300 flex flex-col justify-between">
              <div>
                <span class="font-serif text-3xl text-ink/20 font-light block mb-6">
                  {step.step}
                </span>
                <h3 class="text-lg font-serif text-ink mb-2">
                  {step.title}
                </h3>
                <p class="text-sm text-ink-muted leading-relaxed">
                  {step.desc}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* Call to Action Section */}
    <section id="contact" class="py-24 md:py-32 bg-ink text-white relative overflow-hidden">
      {/* Ambient background light */}
      <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-sky-500/10 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>
      <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-sun/10 rounded-full blur-[140px] pointer-events-none" aria-hidden="true"></div>

      <div class="container mx-auto px-6 max-w-4xl relative z-10 text-center flex flex-col items-center">
        <span class="text-xs uppercase tracking-[0.2em] text-white/60 font-medium block mb-4">
          Start a Conversation
        </span>
        <h2 class="text-4xl md:text-6xl lg:text-7xl font-serif tracking-tight mb-6 leading-tight max-w-3xl">
          Let’s craft something <span class="text-white/60">remarkable</span> together.
        </h2>
        <p class="text-lg md:text-xl text-white/80 max-w-xl mb-10 leading-relaxed font-sans">
          Have an upcoming project, redesign, or digital venture in mind? We'd love to hear your vision.
        </p>

        <div class="flex flex-col sm:flex-row items-center gap-4">
          <Button
            as="a"
            href="https://cal.com/mohammed-nedjadi-odx7mx"
            target="_blank"
            rel="noopener noreferrer"
            client:visible
            borderRadius="1.75rem"
            className="bg-black text-white border-neutral-800 font-bold px-8"
            containerClassName="w-auto h-auto min-w-[200px]"
          >
            <span className="flex items-center gap-2">
              <Calendar size={18} />
              <span>Book a Discovery Call</span>
            </span>
          </Button>
          <a 
            href="/projects" 
            class="px-8 py-4 glass text-white text-base font-bold rounded-full hover:bg-canvas/10 transition-all duration-base inline-flex items-center gap-2"
          >
            <span>Explore Selected Work</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

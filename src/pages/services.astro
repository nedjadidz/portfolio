---
import Layout from "../layouts/Layout.astro";
import { Navbar } from "../components/ui/Navbar";
import PageHeader from "../components/PageHeader.astro";
import { ServicesGrid } from "../components/ui/ServicesGrid";
import { Button } from "../components/ui/button";
import { ArrowRight, Calendar } from "lucide-react";
---

<Layout title="Services | Lumina Studio">
  <Navbar client:load />

  <main class="overflow-hidden">
    {/* Hero Page Header */}
    <PageHeader 
      title="Our" 
      highlight="Services" 
      description="We offer end-to-end digital solutions, combining strategic design with cutting-edge engineering to elevate your brand." 
    />

    {/* Services Grid Section */}
    <section class="py-24 md:py-32 bg-canvas relative z-10">
      <div class="container mx-auto px-6 max-w-7xl">
        <div class="max-w-2xl mb-16">
          <span class="text-xs uppercase tracking-[0.2em] text-ink-muted font-medium block mb-3">
            What We Do
          </span>
          <h2 class="text-3xl md:text-5xl font-serif text-ink tracking-tight">
            Comprehensive solutions for <span class="text-ink/40">digital growth</span>
          </h2>
        </div>

        <ServicesGrid client:visible />
      </div>
    </section>

    {/* CTA Section */}
    <section class="py-24 md:py-32 bg-[#F9F9F7] border-t border-line">
      <div class="container mx-auto px-6 max-w-4xl text-center">
        <h2 class="text-3xl md:text-5xl font-serif text-ink tracking-tight mb-6">
          Ready to start your next project?
        </h2>
        <p class="text-lg text-ink-muted max-w-2xl mx-auto mb-10 leading-relaxed">
          Whether you need a complete redesign, a new digital product, or strategic consulting, we are here to help you achieve your goals.
        </p>
        
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <Button asChild size="lg" className="rounded-full font-bold px-8">
            <a href="https://cal.com/mohammed-nedjadi-odx7mx" target="_blank" rel="noopener noreferrer" className="flex items-center gap-2">
              <Calendar size={18} />
              <span>Book a Discovery Call</span>
            </a>
          </Button>
          <a 
            href="/projects" 
            class="px-8 py-4 bg-canvas text-ink text-base font-bold rounded-full border border-line hover:border-line-strong transition-all duration-300 inline-flex items-center gap-2"
          >
            <span>View Our Work</span>
            <ArrowRight size={18} />
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>
